# Copy to .env and fill in. Never commit .env.
# Generate once: docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=
POSTGRES_USER=editguard
POSTGRES_PASSWORD=

# Sent to Wikimedia in the User-Agent header (their policy requires a contact)
CONTACT_EMAIL=

# AWS (staging/prod jobs). The bucket name contains your account ID, so it lives here, not in git.
AWS_PROFILE=editguard-dev
DATA_BUCKET=

# Environment Airflow's dbt runs against: staging (default) or prod
EDITGUARD_DBT_TARGET=

# Streaming containers (make stream): the live job's environment, dev unless set.
# make deploy overrides it (and pins the images) through .deploy.env.
EDITGUARD_ENV=
